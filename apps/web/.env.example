# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables.

# Public URL of the site, used for canonical/hreflang links, the sitemap and
# Open Graph. On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Project Settings → API).
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only key that can write to the waitlist table: the legacy
# "service_role" key or a new "secret" key (sb_secret_…). Never expose it to
# the browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
